[Unit]
Description=Lynceus
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
User=root

Environment=Lynceus_CONFIG=/etc/Lynceus/config.yaml
Environment=Lynceus_HOSTS=/etc/Lynceus/hosts.yaml
Environment=Lynceus_LOGLEVEL=INFO
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/Lynceus/venv/bin/python /opt/Lynceus/Lynceus.py

Restart=always
RestartSec=15
TimeoutStopSec=20

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=/var/lib/Lynceus
ReadOnlyPaths=/etc/Lynceus

StandardOutput=journal
StandardError=journal
SyslogIdentifier=Lynceus

[Install]
WantedBy=multi-user.target
